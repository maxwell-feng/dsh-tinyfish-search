{
  "name": "dsh-tinyfish-search",
  "version": "0.18.0",
  "description": "TinyFish-backed web search provider for DeepSeek Harness (ctx.web): makes the built-in web_search tool run on the TinyFish Search API",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "CONFIG.md",
    "CONFIG.zh.md",
    "INSTALL.md",
    "INSTALL.zh.md",
    "UPDATE.md",
    "UPDATE.zh.md",
    "USAGE.md",
    "USAGE.zh.md",
    "UNINSTALL.md",
    "UNINSTALL.zh.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md",
    "docs"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-alpha.2 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\""
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "web-search",
    "tinyfish",
    "search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxwell-feng/dsh-tinyfish-search.git"
  },
  "bugs": {
    "url": "https://github.com/maxwell-feng/dsh-tinyfish-search/issues"
  },
  "homepage": "https://github.com/maxwell-feng/dsh-tinyfish-search#readme",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.6-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4 || ^4.0.6-alpha.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.7-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-web": ">=0.1.7-alpha.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-web": "0.2.2-alpha.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.2",
    "js-yaml": "4.3.2",
    "typescript": "^5.8.0"
  }
}
