{
  "name": "dsh-tinyfish-search",
  "version": "0.12.0",
  "description": "TinyFish-backed web search provider for DeepSeek Harness (ctx.web): makes the built-in web_search tool run on the TinyFish Search API",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.1.7-alpha.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build && pnpm test",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\""
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "web-search",
    "tinyfish",
    "search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxwell-feng/dsh-tinyfish-search.git"
  },
  "bugs": {
    "url": "https://github.com/maxwell-feng/dsh-tinyfish-search/issues"
  },
  "homepage": "https://github.com/maxwell-feng/dsh-tinyfish-search#readme",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-credentials": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-web": "^0.1.7-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-web": "0.1.7-rc.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.2",
    "js-yaml": "4.3.2",
    "typescript": "5.8.3"
  }
}